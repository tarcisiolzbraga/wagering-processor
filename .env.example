# Papel do processo: api | consumer | outbox | reference
APP_ROLE=api
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=wagering
POSTGRES_PASSWORD=wagering
POSTGRES_DB=wagering

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo

# Autenticacao — ver ARCHITECTURE.md. Desligada por default no desenvolvimento.
AUTH_ENABLED=false
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/jungle
# Opcional. Só é necessária quando a API alcança o Keycloak por outro nome do
# que o anunciado no `iss` do token — é o caso dentro do Compose.
# KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/jungle/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=wagering-api
