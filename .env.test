# Recursos isolados da suite de testes.
#
# `bun test` define NODE_ENV=test, e o Bun carrega este arquivo por cima do
# .env. Sem o isolamento, os workers do Compose competem com os testes pelo
# mesmo banco e pelas mesmas filas.
NODE_ENV=test
POSTGRES_DB=wagering_test

SQS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions-test.fifo
SQS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-test-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events-test.fifo
